# Environment template - do not commit real secrets

# Supabase project for the NEW independent subscription site
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_ONLY_FOR_EDGE_FUNCTIONS_OR_CLI

# Restricted direct database connection for AI agents. Never use the postgres
# owner connection here. Destructive SQL must be reviewed and run manually.
SUPABASE_AI_DB_URL=postgresql://ai_editor:URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Patreon OAuth - only needed if Patreon is enabled
PATREON_CLIENT_ID=YOUR_PATREON_CLIENT_ID
PATREON_CLIENT_SECRET=YOUR_PATREON_CLIENT_SECRET
PATREON_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/patreon-oauth-callback
PATREON_STATE_SECRET=GENERATE_LONG_RANDOM_SECRET
PATREON_CAMPAIGN_ID=OPTIONAL_CAMPAIGN_ID
PATREON_PUBLIC_RETURN_URL=https://YOUR_PUBLIC_READER_ORIGIN/
PATREON_USER_AGENT=Your Site Name / contact@example.com

# Boosty access through Discord roles - only needed if enabled
DISCORD_CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_APPLICATION_SECRET
DISCORD_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/discord-oauth-callback
DISCORD_STATE_SECRET=GENERATE_A_SEPARATE_LONG_RANDOM_SECRET
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID
DISCORD_PUBLIC_RETURN_URL=https://YOUR_PUBLIC_READER_ORIGIN/
BOOSTY_PAGE_URL=https://boosty.to/YOUR_PAGE
# Role verification grants bounded access and is renewed on reader startup/sync.
BOOSTY_DISCORD_ENTITLEMENT_TTL_HOURS=72

# Optional webhook boundary
PROVIDER_WEBHOOK_SECRET=GENERATE_LONG_RANDOM_SECRET

# Per-project reader email delivery (Edge/server only; never frontend config)
RESEND_API_KEY=YOUR_RESEND_API_KEY
READER_EMAIL_FROM=Your Author Name <notifications@YOUR_VERIFIED_DOMAIN>
READER_EMAIL_SITE_NAME=Your Author Name
READER_EMAIL_QUEUE_SECRET=GENERATE_SEPARATE_QUEUE_SECRET

# Optional author AI services (Edge/server only)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
WRITER_AI_APP_TITLE=Your Author Workspace
WRITER_AI_SITE_URL=https://YOUR_PUBLIC_AUTHORING_ORIGIN/
# Use a model supported by the checked-in summary function allowlist.
WRITER_SUMMARY_MODEL=gemma-4-26b-a4b-it
